---
import SITE_CONFIG from "@/config";
import Layout from "@/layouts/Layout/Layout.astro";
import "@/components/Archive/Archive.less";

const { Description } = SITE_CONFIG;
---

<Layout title="公告" description={Description} activeNav="notice">
	<section class="vh-archive-main vh-animation vh-animation-init" data-notices-page>
		<div class="archive-list">
			<div class="archive-list-item" data-notice-list>
				<p class="title">
					<em>全部公告</em>
					<i />
					<span data-notice-count>加载中...</span>
				</p>
			</div>
		</div>
	</section>
</Layout>
