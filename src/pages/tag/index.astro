---
import { getTags } from "@/utils/getPostInfo";
import SITE_CONFIG from "@/config";
import Layout from "@/layouts/Layout/Layout.astro";
import "@/components/Archive/Archive.less";

const { Description } = SITE_CONFIG;
const tags = getTags().sort((a, b) => Number(b[1]) - Number(a[1]) || String(a[0]).localeCompare(String(b[0])));
---

<Layout title="标签" description={Description} activeNav="tags">
	<section class="vh-archive-main vh-animation vh-animation-init">
		<div class="archive-list">
			<div class="archive-list-item" data-tag-filter>
				<p class="title">
					<em>全部标签</em>
					<i />
					<span data-tag-count>{tags.length}个标签</span>
					<label class="tag-search">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="m19.6 21l-6.3-6.3q-.75.6-1.725.95T9.5 16q-2.725 0-4.612-1.888T3 9.5t1.888-4.612T9.5 3t4.613 1.888T16 9.5q0 1.1-.35 2.075T14.7 13.3l6.3 6.3zM9.5 14q1.875 0 3.188-1.312T14 9.5t-1.312-3.187T9.5 5T6.313 6.313T5 9.5t1.313 3.188T9.5 14"></path></svg>
						<input type="text" placeholder="筛选标签" aria-label="筛选标签" data-tag-search />
					</label>
				</p>
				{tags.map(([tag, count]) => (
					<a href={`/tag/${String(tag)}`} data-tag-name={String(tag).toLowerCase()}>
						<span>{String(tag)}</span>
						<i />
						<cite>{count}篇文章</cite>
					</a>
				))}
				<div class="tag-empty" hidden>没有匹配的标签</div>
			</div>
		</div>
	</section>
</Layout>
